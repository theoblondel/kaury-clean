{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kaury Clean",
  "version": "0.6.0",
  "identifier": "studio.kaury.clean",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Kaury Clean",
        "width": 1180,
        "height": 780,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "backgroundColor": "#1C1A1A",
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Kaury Studio",
    "copyright": "Kaury Studio",
    "category": "Utility",
    "shortDescription": "Nettoyeur de PC Windows",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "languages": [
          "French",
          "English"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "startMenuFolder": "Kaury Studio"
      }
    },
    "longDescription": "Kaury Clean nettoie, range et répare ton PC Windows : fichiers inutiles, caches, gros fichiers, doublons, applis au démarrage, désinstallation et outils de réparation.",
    "homepage": "https://kaury.studio"
  }
}
